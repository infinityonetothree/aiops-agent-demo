# Export these in the shell before running. Do not commit real secrets.
AIOPS_CONTAINER=aiops-recommendation
AIOPS_SERVICE_URL=http://127.0.0.1:8088
AIOPS_PROMETHEUS_URL=http://127.0.0.1:9090
AIOPS_DOCKER_PROJECT=aiopsagent
AIOPS_ALLOWED_TARGETS=recommendation
AIOPS_CONFIDENCE_THRESHOLD=0.6
